+/* ------------------------------------------------------------------- menu --- */
+
+/* Fronteira do framebuffer: o driver de video (scr_libretro.c) trava isto ao
+ * desenhar e o retro_run trava ao entregar o quadro ao frontend. */
+void zx_fb_lock(void)   { pthread_mutex_lock(&zx_fb_mutex); }
+void zx_fb_unlock(void) { pthread_mutex_unlock(&zx_fb_mutex); }
+
+bool zx_menu_active(void)
+{
+    return zx_menu_alive != 0;
+}
+
+static void zx_key_send(int k, int down)
+{
+    if (k >= 0 && (size_t)k < sizeof(zx_key_held))
+        zx_key_held[k] = (unsigned char)(down ? 1 : 0);
+    util_set_reset_key((enum util_teclas)k, down ? 1 : 0);
+}
+
+/* Evita tecla "presa" quando o menu abre/fecha com algo pressionado. */
+static void zx_release_all_keys(void)
+{
+    size_t k;
+    for (k = 0; k < sizeof(zx_key_held); k++)
+        if (zx_key_held[k])
+        {
+            zx_key_held[k] = 0;
+            util_set_reset_key((enum util_teclas)k, 0);
+        }
+}
+
+static void *zx_menu_thread_main(void *arg)
+{
+    (void)arg;
+    menu_inicio();              /* bloqueia ate o usuario sair do menu */
+    menu_set_menu_abierto(0);
+    zx_menu_done = 1;           /* a thread do frontend faz o join */
+    return NULL;
+}
+
+static bool zx_menu_start(int osd)
+{
+    pthread_attr_t attr;
+    int rc;
+
+    if (zx_menu_alive)
+        return true;
+
+    zx_release_all_keys();
+    zx_menu_done = 0;
+    zx_menu_osd  = osd;
+
+    /* Com multitarea ligada o menu chama cpu_core_loop() por conta propria,
+     * e a CPU rodaria numa segunda thread ao mesmo tempo que zx_run_frame. */
+    menu_multitarea = 0;
+
+    /* Pedido nativo do engine: menu_si_pulsada_tecla_osd() (zxvision.c) le esta
+     * flag e abre o teclado direto, sem mostrar o menu principal. */
+    if (osd)
+        menu_button_osdkeyboard.v = 1;
+
+    menu_set_menu_abierto(1);
+
+    /* O menu usa buffers grandes na pilha (seletor de arquivos); nao confiar
+     * no tamanho padrao de thread (1 MB no Windows). */
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 8u * 1024u * 1024u);
+    rc = pthread_create(&zx_menu_thr, &attr, zx_menu_thread_main, NULL);
+    pthread_attr_destroy(&attr);
+
+    if (rc != 0)
+    {
+        debug_printf(VERBOSE_ERR, "[libretro] nao consegui criar a thread do menu\n");
+        menu_set_menu_abierto(0);
+        menu_button_osdkeyboard.v = 0;
+        zx_menu_osd = 0;
+        return false;
+    }
+
+    zx_menu_alive = 1;
+    return true;
+}
+
+/* Chamada pela thread do frontend: se o menu terminou, junta a thread. */
+static void zx_menu_reap(void)
+{
+    if (!zx_menu_alive || !zx_menu_done)
+        return;
+
+    pthread_join(zx_menu_thr, NULL);
+    zx_menu_alive = 0;
+    zx_menu_done  = 0;
+    zx_menu_osd   = 0;
+    menu_button_osdkeyboard.v = 0;
+    zx_release_all_keys();
+}
+
+/* Fecha o menu "como o usuario faria": ESC ate a thread terminar. Usado em
+ * unload/deinit/reset, onde nao da para deixar a thread viva. */
+static void zx_menu_close_blocking(void)
+{
+    int i;
+
+    zx_menu_wanted = 0;
+    zx_osd_wanted  = 0;
+    if (!zx_menu_alive)
+        return;
+
+    for (i = 0; i < 100 && !zx_menu_done; i++)
+    {
+        zx_key_send(UTIL_KEY_ESC, 1);
+        usleep(30000);
+        zx_key_send(UTIL_KEY_ESC, 0);
+        usleep(30000);
+    }
+
+    if (zx_menu_done)
+        zx_menu_reap();
+    else
+        debug_printf(VERBOSE_ERR, "[libretro] o menu nao fechou; thread deixada viva\n");
+}
+
+/* Joypad -> teclas, so enquanto o menu esta aberto (A=Enter, B=Esc). */
+static void zx_menu_joy(uint16_t m)
+{
+    static uint16_t prev;
+    static const struct { unsigned id; int key; } map[] = {
+        { RETRO_DEVICE_ID_JOYPAD_UP,    UTIL_KEY_UP    },
+        { RETRO_DEVICE_ID_JOYPAD_DOWN,  UTIL_KEY_DOWN  },
+        { RETRO_DEVICE_ID_JOYPAD_LEFT,  UTIL_KEY_LEFT  },
+        { RETRO_DEVICE_ID_JOYPAD_RIGHT, UTIL_KEY_RIGHT },
+        { RETRO_DEVICE_ID_JOYPAD_A,     UTIL_KEY_ENTER },
+        { RETRO_DEVICE_ID_JOYPAD_B,     UTIL_KEY_ESC   },
+    };
+    uint16_t changed = (uint16_t)(m ^ prev);
+    size_t i;
+
+    for (i = 0; i < sizeof(map) / sizeof(map[0]); i++)
+        if (changed & (1u << map[i].id))
+            zx_key_send(map[i].key, (m >> map[i].id) & 1);
+
+    prev = m;
+}
